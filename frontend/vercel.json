{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|images/|service-images/|favicon\\.ico|favicon\\.svg|sa-logo\\.png|customer-booking\\.jpg|hero-bg-animated\\.mp4|hero-technician-cutout\\.png|prefooter-livingroom\\.jpg|robot-video-poster\\.jpg|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
