{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm run install:frontend",
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/((?!api(?:/|$)|assets(?:/|$)|.*\\.[^/]+$).*)", "destination": "/index.html" }
  ]
}
