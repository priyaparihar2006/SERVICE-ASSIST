{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "cd backend && npm install && npm run build && cd ../frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!assets/|images/|service-images/|favicon\\.ico|favicon\\.svg|sa-logo\\.png|customer-booking\\.jpg|gemini_generated_video_.*\\.mp4|hero-bg-animated\\.mp4|hero-technician-cutout\\.png|prefooter-livingroom\\.jpg|robot-video-poster\\.jpg|.*\\.[\\w]+$).*)",
      "destination": "/index.html"
    }
  ]
}
