# Server Environment
NODE_ENV=production
PORT=5000

# PostgreSQL Connection String (Supports Supabase, Neon, Railway, Vercel Postgres, AWS RDS, etc.)
# Must start with postgresql:// or postgres://
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# JWT Secret for Session Authentication (minimum 32 random characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_long_random_jwt_secret_at_least_32_chars

# Frontend URLs allowed to communicate with this backend (comma-separated origins)
# Example: https://service-assist-frontend.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-frontend.vercel.app
FRONTEND_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Cookie SameSite setting: 'none' for cross-origin production setups (requires HTTPS), 'lax' for same-site
COOKIE_SAME_SITE=none
TRUST_PROXY=1

# Chat Master Encryption Key (32 random bytes base64 encoded)
# Generate with: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
CHAT_ENCRYPTION_KEYS=1:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
CHAT_ACTIVE_KEY_VERSION=1
CHAT_BLOCK_CONTACT_INFO=true

# Optional AI Assistant configuration (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database Seeding (Set to 'true' to seed initial categories & services)
SEED_DEMO=false
DEMO_PASSWORD=StrongDemoPassword123!

# Admin Creation (Used only by: npm run admin:create)
ADMIN_EMAIL=admin@service-assist.com
ADMIN_PASSWORD=StrongAdminPassword123!
