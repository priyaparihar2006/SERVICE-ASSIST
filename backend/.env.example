NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://service_assist:CHANGE_ME@localhost:5432/service_assist?schema=public
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
FRONTEND_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=lax
TRUST_PROXY=0
# Private chat. Master keys wrap each conversation's data key; message text is stored only as
# AES-256-GCM ciphertext. Format: version:base64(32 random bytes)[,version:base64...]
# Generate one with: node -e "console.log('1:'+require('crypto').randomBytes(32).toString('base64'))"
# In production load these from a secret manager; never commit them. Keep retired versions listed
# until `npm run chat:rotate-keys` has re-wrapped every conversation.
CHAT_ENCRYPTION_KEYS=REPLACE_WITH_1:BASE64_OF_32_RANDOM_BYTES
CHAT_ACTIVE_KEY_VERSION=1
# Reject phone numbers / e-mail addresses typed into chat messages (best effort; default true).
CHAT_BLOCK_CONTACT_INFO=true
# Optional AI provider configuration; never put these in frontend.
GEMINI_API_KEY=
GEMINI_MODEL=
# Demo seeding is refused in production.
SEED_DEMO=false
DEMO_PASSWORD=
# Used only by npm run admin:create
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Separate disposable test database; database name must end in _test.
TEST_DATABASE_URL=
